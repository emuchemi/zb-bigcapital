# ============================================================
# Zahir and Batin — BigCapital Homelab Environment Variables
# ============================================================
#
# INSTRUCTIONS:
#   1. Copy this file:  cp .env.homelab.example .env
#   2. Fill in every value marked  ← CHANGE THIS
#   3. Never commit your .env file to Git (it contains passwords)
#   4. Keep a secure offline copy of this file (e.g. in Bitwarden)
#
# To generate a secure random secret (run in terminal):
#   openssl rand -hex 32
#
# ============================================================


# ────────────────────────────────────────────────────────────
# APPLICATION
# ────────────────────────────────────────────────────────────

# The URL where BigCapital is accessed.
# LOCAL ACCESS: use your Proxmox host IP, e.g. http://192.168.1.50
# REMOTE ACCESS: use your Cloudflare Tunnel domain once configured,
#                e.g. https://finance.zahirandbatin.com
BASE_URL=http://192.168.1.50                        # ← CHANGE THIS

# Port the app listens on (default 80 is fine for local access)
PUBLIC_PORT=80

# JWT secret — signs user login tokens.
# Generate with: openssl rand -hex 32
# IMPORTANT: Change this from the placeholder. Do not share it.
JWT_SECRET=                                          # ← CHANGE THIS (openssl rand -hex 32)


# ────────────────────────────────────────────────────────────
# DATABASE — MariaDB
# ────────────────────────────────────────────────────────────
# All financial data is stored here.
# IMPORTANT: Back this up regularly (see DEPLOYMENT.md for backup instructions).

# Database username (not root — use the dedicated user)
DB_USER=zb_bigcapital                               # ← You may change this

# Database password for the user above
# Generate with: openssl rand -hex 16
DB_PASSWORD=                                         # ← CHANGE THIS

# Database root password (for admin tasks only)
# Generate with: openssl rand -hex 16
DB_ROOT_PASSWORD=                                    # ← CHANGE THIS

# Character encoding — utf8mb4 supports all characters including Arabic/Swahili
DB_CHARSET=utf8mb4

# Name of the system database (stores users and tenant/company list)
SYSTEM_DB_NAME=zb_system

# Prefix for each company's database.
# Zahir and Batin Limited will get a database named e.g. zb_tenant_1
TENANT_DB_NAME_PERFIX=zb_tenant_


# ────────────────────────────────────────────────────────────
# FILE STORAGE — MinIO (local S3-compatible)
# ────────────────────────────────────────────────────────────
# MinIO stores receipt photos and document attachments locally on your homelab.
# No AWS account needed.
#
# Admin console is available at:  http://<your-lxc-ip>:9001
# Accessible from your local network (laptop, desktop on same LAN).
# Do NOT expose port 9001 to the public internet.

# MinIO admin username (equivalent to AWS Access Key ID)
MINIO_ROOT_USER=zb-minio-admin                      # ← You may change this

# MinIO admin password (equivalent to AWS Secret Access Key)
# Generate with: openssl rand -hex 20
MINIO_ROOT_PASSWORD=                                 # ← CHANGE THIS

# Name of the bucket where attachments are stored
MINIO_BUCKET=zb-attachments

# MinIO storage region — set to us-east-1 (required by S3 SDK, value doesn't matter for MinIO)
S3_REGION=us-east-1


# ────────────────────────────────────────────────────────────
# EXCHANGE RATES — Open Exchange Rates
# ────────────────────────────────────────────────────────────
# Provides live TZS, USD, EUR, GBP exchange rates.
# Free account at: https://openexchangerates.org/signup/free
# Free tier allows 1,000 API calls/month (more than enough).

EXCHANGE_RATE_SERVICE=open-exchange-rate

# Your App ID from the Open Exchange Rates dashboard
OPEN_EXCHANGE_RATE_APP_ID=                           # ← CHANGE THIS (after creating free account)


# ────────────────────────────────────────────────────────────
# EMAIL — Optional but recommended for password reset
# ────────────────────────────────────────────────────────────
# Used to send password reset emails and notifications.
# If left blank, password resets must be done manually by the admin.
#
# Option 1: Use Gmail with an App Password
#   Host:     smtp.gmail.com
#   Port:     587
#   Secure:   false
#   Username: your.gmail.address@gmail.com
#   Password: your Gmail App Password (NOT your regular password)
#   Generate App Password: https://myaccount.google.com/apppasswords
#
# Option 2: Use a transactional email service (e.g. Mailgun, Resend)
#
# Option 3: Leave blank if email is not needed yet

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USERNAME=                                       # ← CHANGE THIS (or leave blank)
MAIL_PASSWORD=                                       # ← CHANGE THIS (App Password, not Gmail password)
MAIL_FROM_NAME=Zahir and Batin
MAIL_FROM_ADDRESS=accounts@zahirandbatin.com         # ← CHANGE THIS (or leave blank)


# ────────────────────────────────────────────────────────────
# SIGN-UP RESTRICTIONS
# ────────────────────────────────────────────────────────────
# Control who can create accounts.
# For Zahir and Batin, we disable open sign-up.
# New users are invited by the admin from within the application.

# Set to true to disable self-registration (recommended)
SIGNUP_DISABLED=true

# Allow specific email addresses to sign up even if SIGNUP_DISABLED=true
# Comma-separated list. Include all team email addresses.
# Example: founder@zahirandbatin.com,accountant@example.com
SIGNUP_ALLOWED_EMAILS=                               # ← CHANGE THIS (your email addresses)

# Allow an entire domain to sign up (leave blank if not needed)
SIGNUP_ALLOWED_DOMAINS=

# Require email confirmation before users can log in
# Set to false if email is not configured
SIGNUP_EMAIL_CONFIRMATION=false


# ────────────────────────────────────────────────────────────
# API RATE LIMITING (Redis-backed throttler)
# ────────────────────────────────────────────────────────────
# These are the variables the server ACTUALLY reads. TTL is in milliseconds.
# The compose file already sets generous defaults; only override here if needed.
# - GLOBAL: all API requests. Upstream default (100/min) is too low for the
#   setup wizard + SPA, causing 429 "too many requests". We use 5000/min.
# - AUTH: login/signup endpoints only (brute-force guard).
# Note: behind the Cloudflare tunnel all users may share one rate-limit bucket,
# so keep the global limit comfortably high for multi-user use.

THROTTLE_GLOBAL_TTL=60000
THROTTLE_GLOBAL_LIMIT=5000
THROTTLE_AUTH_TTL=60000
THROTTLE_AUTH_LIMIT=50


# ────────────────────────────────────────────────────────────
# DISABLED CLOUD SERVICES
# ────────────────────────────────────────────────────────────
# These BigCapital cloud features are not used in the homelab setup.
# Leave as-is.

# Bank feed sync (Plaid) — not available in Tanzania, disabled
BANK_FEED_ENABLED=false

# BigCapital cloud billing — not applicable for self-hosted
HOSTED_ON_BIGCAPITAL_CLOUD=false

# Plaid — US/EU bank connection service (not applicable)
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_LINK_WEBHOOK=

# LemonSqueezy — BigCapital's cloud subscription billing (not applicable)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# PostHog — BigCapital's analytics (optional, leave blank for privacy)
POSTHOG_API_KEY=
POSTHOG_HOST=

# New Relic — cloud monitoring (not needed for homelab)
NEW_RELIC_DISTRIBUTED_TRACING_ENABLED=
NEW_RELIC_LOG=
NEW_RELIC_AI_MONITORING_ENABLED=
NEW_RELIC_CUSTOM_INSIGHTS_EVENTS_MAX_SAMPLES_STORED=
NEW_RELIC_SPAN_EVENTS_MAX_SAMPLES_STORED=
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=


# ────────────────────────────────────────────────────────────
# STRIPE PAYMENTS — Future integration
# ────────────────────────────────────────────────────────────
# Leave blank for now. Configure when Stripe integration is ready.

STRIPE_PAYMENT_SECRET_KEY=
STRIPE_PAYMENT_PUBLISHABLE_KEY=
STRIPE_PAYMENT_CLIENT_ID=
STRIPE_PAYMENT_WEBHOOKS_SECRET=
STRIPE_PAYMENT_REDIRECT_URL=


# ────────────────────────────────────────────────────────────
# BACKUP TARGET — TrueNAS
# ────────────────────────────────────────────────────────────
# Used by the backup script (docker/backup/backup.sh).
# Set this to the path where TrueNAS is mounted on the Proxmox host,
# or to the remote TrueNAS share path.
#
# Example (NFS mount):  /mnt/truenas/backups/bigcapital
# Example (local path): /backups/bigcapital

BACKUP_TARGET_PATH=/mnt/truenas/backups/bigcapital  # ← CHANGE THIS

# How many days of backups to keep
BACKUP_RETAIN_DAYS=30
